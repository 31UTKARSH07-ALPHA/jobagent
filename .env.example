# Copy to .env. Loaded by `node --env-file-if-exists=.env` (see package.json scripts).

# Anthropic — scoring (haiku) and drafting (opus)
ANTHROPIC_API_KEY=sk-ant-...

# Telegram — morning digest + approve/reject buttons (Phase 1 / 3)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gmail OAuth (Phase 1). Paths are relative to the project root.
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json

# Optional overrides
JOBAGENT_DB=data/jobagent.db
